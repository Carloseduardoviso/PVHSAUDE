@model PVHSAUDE.Application.ViewModels.LoginVm
@{ ViewData["Title"] = "Entrar na administração"; }
<section class="login-page" aria-labelledby="login-title">
    <div class="login-card">
        <div class="login-brand">
            <img src="~/images/pvh-saude-horizontal.jpeg" asp-append-version="true" alt="PVH Saúde" />
        </div>
        <div class="login-heading">
            <span class="login-eyebrow">ÁREA ADMINISTRATIVA</span>
            <h1 id="login-title">Entrar na administração</h1>
            <p>Informe seus dados para acessar o painel da PVH Saúde.</p>
        </div>
        <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="login-form">
            <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>
            <div class="login-field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="username" placeholder="seu@email.com" /><span asp-validation-for="Email"></span></div>
            <div class="login-field"><label asp-for="Senha"></label><input asp-for="Senha" autocomplete="current-password" placeholder="Digite sua senha" /><span asp-validation-for="Senha"></span></div>
            <button class="login-submit" type="submit">Entrar <span aria-hidden="true">→</span></button>
        </form>
        <p class="login-footer-note">Acesso restrito à equipe autorizada.</p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
