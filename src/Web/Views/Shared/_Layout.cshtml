@{ var isLoginPage = string.Equals(ViewContext.RouteData.Values["Controller"]?.ToString(), "Conta", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Login", StringComparison.OrdinalIgnoreCase); }
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PVH Saúde</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
</head>
<body class="portal-body@(isLoginPage ? " login-body" : "")">
    @if (!isLoginPage)
    {
    <header>
        <nav class="navbar navbar-expand-xxl portal-navbar">
            <div class="container-fluid portal-navbar-inner">
                <a class="navbar-brand portal-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="PVH Saúde — início"><img src="~/images/pvh-saude-horizontal.jpeg" asp-append-version="true" alt="PVH Saúde — descontos e benefícios" width="998" height="548" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir ou fechar menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarSupportedContent" class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav portal-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Credenciadas"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14M8 8h2m4 0h2m-8 4h2m4 0h2M9 20v-4h6v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>Clínica Terapêutica Credenciada</a>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle border-0 bg-transparent" type="button" id="clinica-parceira-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14M8 8h2m4 0h2m-8 4h2m4 0h2M9 20v-4h6v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>Clínica Parceira
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="clinica-parceira-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="ClinicaTerapeutica"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14M8 8h2m4 0h2m-8 4h2m4 0h2M9 20v-4h6v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>Clínica Terapêutica</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="ClinicaMedicaTerapeutica"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 3v7a4 4 0 0 0 8 0V3M6 3h4M14 3h4m-6 11v7m-4 0h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Clínica Médica e Especialidade</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="LaboratorioExames"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 3h6m-5 0v6l-5.5 9.2A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-2.8L14 9V3m-6 11h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>Laboratório e Exames</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="ExamesImagens"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="8" cy="9" r="1.3" fill="currentColor" /></svg>Exames e Imagens</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Odontologia"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4c2-2 3 1 5 1s3-3 5-1c3 2 2 6 1 9s-1 7-3 7c-2 0-1-5-3-5s-1 5-3 5c-2 0-2-4-3-7S4 6 7 4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>Odontologia</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="ClinicasPopulares"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V6h16v14M8 10h2m4 0h2m-8 4h2m4 0h2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Clínicas Populares</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle border-0 bg-transparent" type="button" id="esporte-parceiros-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 4v16m12-16v16M3 8h6m6 0h6M3 16h6m6 0h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Esporte Parceiros
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="esporte-parceiros-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Academia"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 4v16m12-16v16M3 8h6m6 0h6M3 16h6m6 0h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Academia</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Futebol"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>Futebol</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Natacao"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 9c2.2-2 4.2-2 6.5 0s4.3 2 6.5 0 4.3-2 5.5-.8M3 15c2.2-2 4.2-2 6.5 0s4.3 2 6.5 0 4.3-2 5.5-.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Natação</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle border-0 bg-transparent" type="button" id="loja-parceiras-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9h16l-1-5H5L4 9Zm1 0v10h14V9M9 13h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>Loja Parceiras
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="loja-parceiras-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Otica"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 10c1-2 4-2 5 0 1-2 4-2 5 0 1-2 4-2 5 0 1-2 4-2 5 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Ótica</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="RoupaEsportiva"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m8 4 4 2 4-2 4 4-3 3v9H7v-9L4 8l4-4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>Roupa Esportiva</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Contato" asp-action="Index"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v11H8l-4 4V5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>Contato</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="SobreNos"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 11v5m0-8h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Sobre Nós</a>
                        </li>
                    </ul>
                    <div class="portal-nav-actions d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2">
                        <a asp-area="" asp-controller="Carteirinha" asp-action="Index" class="btn portal-carteirinha-button">Peça sua carteirinha</a>
                        <a asp-area="Administracao" asp-controller="Dashboard" asp-action="Index" class="btn portal-admin-button">Área administrativa</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    }
    <div class="container portal-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (!isLoginPage)
    {
    <footer class="footer portal-footer">
        <div class="container">
            &copy; 2026 - PVH Saúde - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <a class="whatsapp-float" asp-area="" asp-controller="WhatsApp" asp-action="Index" target="_blank" rel="noopener noreferrer" aria-label="Fale conosco pelo WhatsApp">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path d="M16 3.2a12.8 12.8 0 0 0-10.9 19.5L3.4 29l6.5-1.7A12.8 12.8 0 1 0 16 3.2Zm0 23.3a10.5 10.5 0 0 1-5.3-1.4l-.4-.2-3.9 1 1-3.8-.2-.4a10.5 10.5 0 1 1 8.8 4.8Zm5.8-7.9c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.5 8.5 0 0 1-2.5-1.5 9.3 9.3 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.7l.5-.6c.2-.2.2-.4.3-.6s0-.4 0-.5-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4a3.1 3.1 0 0 0-1 2.3c0 1.4 1 2.8 1.1 3 .2.2 2 3.1 4.8 4.4 2.8 1.3 2.8.9 3.3.9s1.8-.7 2-1.4.3-1.3.2-1.4c-.1-.1-.3-.2-.6-.3Z"/>
        </svg>
    </a>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
