<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PVH Saúde</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
</head>
<body class="portal-body">
    <header>
        <nav class="navbar navbar-expand-xxl portal-navbar">
            <div class="container-fluid portal-navbar-inner">
                <a class="navbar-brand portal-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="PVH Saúde — início"><img src="~/images/pvh-saude-horizontal.jpeg" asp-append-version="true" alt="PVH Saúde — descontos e benefícios" width="998" height="548" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir ou fechar menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarSupportedContent" class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav portal-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Credenciadas">Clínica Terapêutica Credenciada</a>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle border-0 bg-transparent" type="button" id="clinica-parceira-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                Clínica Parceira
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="clinica-parceira-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="ClinicaTerapeutica">Clínica Terapêutica</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="ClinicaMedicaTerapeutica">Clínica Médica Terapêutica</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="LaboratorioExames">Laboratório e Exames</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Odontologia">Odontologia</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="ClinicasPopulares">Clínicas Populares</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle border-0 bg-transparent" type="button" id="esporte-parceiros-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                Esporte Parceiros
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="esporte-parceiros-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Sports" asp-action="Academia">Academia</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Sports" asp-action="Futebol">Futebol</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Sports" asp-action="Natacao">Natação</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle border-0 bg-transparent" type="button" id="loja-parceiras-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                Loja Parceiras
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="loja-parceiras-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Lojas" asp-action="Otica">Ótica</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Lojas" asp-action="RoupaEsportiva">Roupa Esportiva</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Contato" asp-action="Index">Contato</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="SobreNos">Sobre Nós</a>
                        </li>
                    </ul>
                    <div class="portal-nav-actions d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2">
                        <a asp-area="" asp-controller="Carteirinha" asp-action="Index" class="btn portal-carteirinha-button">Peça sua carteirinha</a>
                        <a asp-area="Administracao" asp-controller="Dashboard" asp-action="Index" class="btn portal-admin-button">Área administrativa</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container portal-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer portal-footer">
        <div class="container">
            &copy; 2026 - PVH Saúde - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <a class="whatsapp-float" asp-area="" asp-controller="WhatsApp" asp-action="Index" target="_blank" rel="noopener noreferrer" aria-label="Fale conosco pelo WhatsApp">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path d="M16 3.2a12.8 12.8 0 0 0-10.9 19.5L3.4 29l6.5-1.7A12.8 12.8 0 1 0 16 3.2Zm0 23.3a10.5 10.5 0 0 1-5.3-1.4l-.4-.2-3.9 1 1-3.8-.2-.4a10.5 10.5 0 1 1 8.8 4.8Zm5.8-7.9c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.5 8.5 0 0 1-2.5-1.5 9.3 9.3 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.7l.5-.6c.2-.2.2-.4.3-.6s0-.4 0-.5-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4a3.1 3.1 0 0 0-1 2.3c0 1.4 1 2.8 1.1 3 .2.2 2 3.1 4.8 4.4 2.8 1.3 2.8.9 3.3.9s1.8-.7 2-1.4.3-1.3.2-1.4c-.1-.1-.3-.2-.6-.3Z"/>
        </svg>
    </a>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
