@{
    ViewData["Title"] = "Peça sua carteirinha";
}
<link rel="stylesheet" href="~/css/carteirinha.css" asp-append-version="true" />
<section class="carteirinha-page" aria-labelledby="carteirinha-title">
    <div class="carteirinha-heading">
        <span class="carteirinha-eyebrow">PVH SAÚDE · PARA VOCÊ</span>
        <h1 id="carteirinha-title">Peça sua carteirinha</h1>
        <p>Seu próximo passo para cuidar de você e da sua família.</p>
    </div>
    <div class="carteirinha-layout">
        <div class="carteirinha-panel">
            <ol class="carteirinha-steps" aria-label="Etapas da solicitação">
                <li aria-current="step"><span>1</span>Cadastro</li>
                <li><span>2</span>Endereço</li>
                <li><span>3</span>Adicionais</li>
                <li><span>4</span>Pagamento</li>
            </ol>
            <form id="carteirinha-form" data-valor-dependente="@PVHSAUDE.Domain.Entities.Dependente.Valor.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                @Html.AntiForgeryToken()
                <section data-step="0" aria-labelledby="cadastro-title">
                    <h2 id="cadastro-title" tabindex="-1">Vamos começar pelo seu cadastro</h2>
                    <p class="carteirinha-muted">Preencha seus dados. Os campos com * são obrigatórios.</p>
                    <div class="carteirinha-fields">
                        <label>Nome completo *<input name="nome" autocomplete="name" required minlength="3" maxlength="150" placeholder="Seu nome completo" /></label>
                        <label>E-mail *<input name="email" type="email" autocomplete="email" required maxlength="150" placeholder="voce@exemplo.com" /></label>
                        <label>WhatsApp *<input name="telefone" type="tel" autocomplete="tel" required inputmode="tel" maxlength="16" placeholder="(69) 99999-9999" /></label>
                        <label>CPF *<input name="cpf" autocomplete="off" required inputmode="numeric" maxlength="14" placeholder="000.000.000-00" /></label>
                        <label>Data de nascimento *<input name="dataNascimento" type="date" autocomplete="bday" required max="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
                        <label>Plano *<select name="planoId" id="plano-carteirinha" required><option value="">Selecione seu plano</option>@foreach (var plano in (IEnumerable<Web.Models.PlanoVm>?)ViewBag.Planos ?? []) { <option value="@plano.Id" data-valor="@plano.Valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))">@plano.Nome — @plano.Valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</option> }</select></label>
                    </div>
                    @if (ViewData["PlanosErro"] is string planosErro) { <p class="carteirinha-muted" role="alert">@planosErro</p> }
                    <label class="carteirinha-check"><input name="maiorIdade" type="checkbox" required />Confirmo que tenho 18 anos ou mais. *</label>
                    <label class="carteirinha-check"><input name="comunicacoes" type="checkbox" />Quero receber novidades da PVH Saúde por canais digitais.</label>
                </section>
                <section data-step="1" aria-labelledby="endereco-title" hidden>
                    <h2 id="endereco-title" tabindex="-1">Onde você mora?</h2>
                    <p class="carteirinha-muted">Informe seu endereço completo.</p>
                    <div class="carteirinha-fields">
                        <label>CEP *<input name="cep" autocomplete="postal-code" required inputmode="numeric" maxlength="9" placeholder="00000-000" aria-describedby="carteirinha-cep-status" /><span id="carteirinha-cep-status" class="carteirinha-muted" role="status" aria-live="polite"></span></label>
                        <label>Rua *<input name="rua" autocomplete="address-line1" required maxlength="150" placeholder="Nome da rua ou avenida" /></label>
                        <label>Bairro *<input name="bairro" required maxlength="100" placeholder="Seu bairro" /></label>
                        <label>Número *<input name="numero" required maxlength="15" placeholder="Número ou S/N" /></label>
                        <label>Cidade *<input name="cidade" autocomplete="address-level2" required maxlength="100" placeholder="Sua cidade" /></label>
                        <label>Estado *<select name="uf" autocomplete="address-level1" required><option value="">Selecione</option>@foreach (var uf in new[] { "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA", "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI", "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO" }) { <option value="@uf">@uf</option> }</select></label>
                        <label class="carteirinha-full">Complemento <span class="carteirinha-optional">(opcional)</span><input name="complemento" autocomplete="address-line2" maxlength="100" placeholder="Apartamento, bloco, referência..." /></label>
                    </div>
                </section>
                <section data-step="2" aria-labelledby="adicionais-title" hidden>
                    <h2 id="adicionais-title" tabindex="-1">Sua carteirinha, do seu jeito</h2>
                    <p class="carteirinha-muted">Inclua até 5 dependentes na sua carteirinha, se desejar.</p>
                    <label class="carteirinha-check"><input id="incluir-dependentes" type="checkbox" />Incluir dependentes</label>
                    <div id="dependentes-carteirinha" hidden>
                        <div id="dependentes-carteirinha-lista"></div>
                        <button type="button" class="carteirinha-link" id="adicionar-dependente-carteirinha">Adicionar dependente</button>
                        <p id="dependentes-limite-carteirinha" class="carteirinha-muted" hidden>Limite de 5 dependentes atingido.</p>
                    </div>
                    <template id="dependente-carteirinha-template"><article class="carteirinha-dependent"><h3>Dependente</h3><div class="carteirinha-fields"><label>Nome completo *<input data-dependent="nome" required maxlength="150" /></label><label>CPF *<input data-dependent="cpf" required inputmode="numeric" maxlength="14" /></label><label>Data de nascimento *<input data-dependent="nascimento" type="date" required /></label><label>Parentesco *<select data-dependent="parentesco" required><option value="">Selecione o parentesco</option><option>Filho(a)</option><option>Cônjuge</option><option>Pai/Mãe</option><option>Outro</option></select></label></div><button type="button" class="carteirinha-link" data-dependent="remover">Remover</button></article></template>
                </section>
                <section data-step="3" aria-labelledby="pagamento-title" hidden>
                    <h2 id="pagamento-title" tabindex="-1">Como você prefere pagar?</h2>
                    <p class="carteirinha-muted">Faça o pagamento da sua carteirinha via Pix.</p>
                    <div class="carteirinha-pix-box">
                        <span class="carteirinha-pix-label">Chave Pix (CNPJ)</span>
                        <strong id="carteirinha-pix-chave">68.895.181/0001-03</strong>
                        <button type="button" class="carteirinha-link" id="copiar-pix">Copiar chave Pix</button>
                        <span class="carteirinha-pix-status" id="pix-status" role="status" aria-live="polite"></span>
                    </div>
                    <input type="hidden" name="pagamento" value="Pix" />
                    <p class="carteirinha-payment-note" id="payment-note" aria-live="polite">Após realizar o Pix, confira os dados e finalize a solicitação.</p>
                    <div class="carteirinha-notice">As opções de cartão de crédito e débito estão temporariamente indisponíveis. O pagamento será confirmado após a identificação do Pix.</div>
                </section>
                <div class="carteirinha-actions"><button type="button" class="carteirinha-link" id="step-back" hidden>← Voltar e editar</button><button type="button" class="carteirinha-primary" id="step-next">Próximo passo <span aria-hidden="true">→</span></button></div>
            </form>
            <section id="carteirinha-review" hidden aria-labelledby="review-title"><h2 id="review-title" tabindex="-1">Revise sua solicitação</h2><p>Confira os dados que você preencheu.</p><dl id="review-values" class="carteirinha-review-values"></dl><div class="carteirinha-notice">Seus dados ainda não foram enviados. A finalização da solicitação estará disponível após a configuração do atendimento e do pagamento.</div><button type="button" class="carteirinha-link" id="review-back">← Voltar e editar</button></section>
            <noscript><p class="carteirinha-notice">Ative o JavaScript do navegador para preencher as etapas.</p></noscript>
        </div>
        <aside class="carteirinha-summary" aria-labelledby="summary-title">
            <div class="carteirinha-card-preview" aria-label="Prévia da carteirinha PVH Saúde">
                <img class="carteirinha-card-logo" src="~/images/pvh-saude-horizontal.jpeg" alt="PVH Saúde+ — Descontos e benefícios. Saúde e economia para sua família." />
                <svg class="carteirinha-card-waves" viewBox="0 0 820 600" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    <path fill="#0063a9" d="M0 345 C190 325 325 440 560 320 C660 268 745 248 820 237 V600 H0Z" />
                    <path fill="#05285f" d="M0 359 C205 340 338 455 565 338 C680 285 753 270 820 260 V600 H0Z" />
                    <path fill="#438a36" d="M340 600 C510 548 520 288 820 237 V600Z" />
                    <path fill="#005c3e" d="M366 600 C532 532 546 306 820 265 V600Z" />
                </svg>
                <div class="carteirinha-card-holder">
                    <span>Titular:</span><strong id="preview-name">Seu nome completo</strong>
                    <span>Data de nascimento:</span><strong id="preview-birthdate" class="carteirinha-card-date">— / — / —</strong>
                    <span>Validade:</span><strong class="carteirinha-card-date">A definir</strong>
                </div>
                <div class="carteirinha-card-benefits"><span>+ Saúde</span><span>+ Economia</span><span>+ Qualidade de vida</span></div>
                <span class="carteirinha-card-footer">Consulta, exames e terapia</span>
            </div>
            <h2 id="summary-title">Sua solicitação</h2>
            <dl><div><dt>Carteirinha</dt><dd>PVH Saúde</dd></div><div><dt>Plano</dt><dd id="summary-plano">A escolher</dd></div><div><dt>Valor do plano</dt><dd id="summary-plano-valor">R$ 0,00</dd></div><div><dt>Dependentes</dt><dd id="summary-dependentes">Nenhum</dd></div><div><dt>Valor por dependente</dt><dd>@PVHSAUDE.Domain.Entities.Dependente.Valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</dd></div><div><dt>Total dos dependentes</dt><dd id="summary-dependentes-total">R$ 0,00</dd></div><div><dt>Total da carteirinha</dt><dd id="summary-total-carteirinha">R$ 0,00</dd></div><div><dt>Pagamento</dt><dd id="summary-payment">A escolher</dd></div></dl>
            <p class="carteirinha-summary-note">Os valores do plano e dos adicionais serão informados antes da contratação.</p>
            <div class="carteirinha-help"><strong>Precisa de ajuda?</strong><p>Nossa equipe pode orientar você.</p><a asp-area="" asp-controller="WhatsApp" asp-action="Index" target="_blank" rel="noopener noreferrer">Fale com a PVH Saúde ↗</a></div>
        </aside>
    </div>
</section>
@section Scripts {
    <script src="~/js/carteirinha.js" asp-append-version="true"></script>
}
