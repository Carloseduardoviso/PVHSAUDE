@model List<Web.Models.BannerViewModel>
@if (Model.Count > 0)
{
<section class="mb-4" aria-label="Destaques">
<div id="banner-carousel" class="carousel slide banner-carousel rounded-3 overflow-hidden" aria-roledescription="carrossel" aria-label="Banners do portal">
<div class="carousel-inner">
@for (var i = 0; i < Model.Count; i++)
{
var b = Model[i];
<div class="carousel-item @(i == 0 ? "active" : "")" role="group" aria-label="@(i + 1) de @Model.Count">
<h2 class="h5 text-center mb-3 banner-titulo">@b.Titulo</h2>
<img src="@Url.Action("BannerImagem", "Home", new { id = b.Id })" alt="@b.Titulo" class="d-block w-100 banner-imagem" />
</div>
}
</div>

</div>
</section>
}
