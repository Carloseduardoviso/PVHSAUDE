@model List<Web.Models.BannerVm>
@using PVHSAUDE.Domain.Enuns
@{
    var centro = Model.Where(x => x.Posicao == PosicaoBanner.Central).ToList();
    var esquerda = Model.Where(x => x.Posicao == PosicaoBanner.LateralEsquerda).ToList();
    var direita = Model.Where(x => x.Posicao == PosicaoBanner.LateralDireita).ToList();
    var inferiorEsquerda = Model.Where(x => x.Posicao == PosicaoBanner.InferiorEsquerda).ToList();
    var inferiorDireita = Model.Where(x => x.Posicao == PosicaoBanner.InferiorDireita).ToList();
}
@if (Model.Count > 0)
{
<section class="portal-banners mb-4" aria-label="Destaques">
    <div class="portal-banners-superior">
        @foreach (var b in esquerda) { <article class="banner-lateral"><h2 class="visually-hidden">@b.Titulo</h2><img src="@Url.Action("BannerImagem", "Home", new { id = b.Id })" alt="@b.Titulo" /></article> }
        <div class="portal-banners-central">
            @foreach (var b in centro) { <article class="banner-central"><h2 class="visually-hidden">@b.Titulo</h2><img src="@Url.Action("BannerImagem", "Home", new { id = b.Id })" alt="@b.Titulo" /></article> }
        </div>
        @foreach (var b in direita) { <article class="banner-lateral"><h2 class="visually-hidden">@b.Titulo</h2><img src="@Url.Action("BannerImagem", "Home", new { id = b.Id })" alt="@b.Titulo" /></article> }
    </div>
    @if (inferiorEsquerda.Count > 0 || inferiorDireita.Count > 0)
    {
    <div class="portal-banners-inferior">
        <div>@foreach (var b in inferiorEsquerda) { <article><h2 class="visually-hidden">@b.Titulo</h2><img src="@Url.Action("BannerImagem", "Home", new { id = b.Id })" alt="@b.Titulo" /></article> }</div>
        <div>@foreach (var b in inferiorDireita) { <article><h2 class="visually-hidden">@b.Titulo</h2><img src="@Url.Action("BannerImagem", "Home", new { id = b.Id })" alt="@b.Titulo" /></article> }</div>
    </div>
    }
</section>
}