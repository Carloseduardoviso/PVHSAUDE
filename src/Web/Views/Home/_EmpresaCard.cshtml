@model Web.Models.EmpresaCardVm
@{
    var empresa = Model.Empresa;
    var imagens = empresa.ImagemUrls?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? [];
    if (imagens.Count == 0 && !string.IsNullOrWhiteSpace(empresa.ImagemUrl)) imagens.Add(empresa.ImagemUrl);
    var especialidades = Model.Rede.Especialidades.Where(x => empresa.EspecialidadeIds.Contains(x.Id)).Select(x => x.Nome).ToList();
    var procedimentos = Model.Rede.Procedimentos.Where(x => empresa.ProcedimentoIds.Contains(x.Id)).Select(x => x.Nome).ToList();
    var desconto = Model.Rede.Descontos.FirstOrDefault(x => x.Id == empresa.DescontoId);
    var endereco = string.Join(", ", new[] { empresa.Endereco, empresa.Cidade, empresa.Uf }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<article class="rede-card">
    <div class="rede-imagem">
        @if (imagens.Count > 0)
        {
            <div id="galeria-@empresa.Id" class="carousel slide h-100" data-bs-ride="carousel">
                <div class="carousel-inner h-100">
                    @for (var i = 0; i < imagens.Count; i++)
                    {
                        <div class="carousel-item h-100 @(i == 0 ? "active" : "")"><img src="@imagens[i]" alt="@empresa.NomeFantasia - imagem @(i + 1)" /></div>
                    }
                </div>
                @if (imagens.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#galeria-@empresa.Id" data-bs-slide="prev" aria-label="Imagem anterior"><span class="carousel-control-prev-icon" aria-hidden="true"></span></button>
                    <button class="carousel-control-next" type="button" data-bs-target="#galeria-@empresa.Id" data-bs-slide="next" aria-label="Próxima imagem"><span class="carousel-control-next-icon" aria-hidden="true"></span></button>
                }
            </div>
        }
        else
        {
            <span class="rede-sem-imagem" aria-hidden="true">PVH Saúde</span>
        }
    </div>
    <div class="rede-texto">
        <p class="text-success fw-semibold mb-2">Rede credenciada</p>
        <h3 class="h2">@empresa.NomeFantasia</h3>
        <p class="text-muted mb-2">@Html.DisplayFor(_ => empresa.Tipo)</p>
        <div class="credenciamento-detalhes">
            @if (desconto is not null) { <div><span>Desconto</span><strong>@desconto.Nome</strong></div> }
            @if (!string.IsNullOrWhiteSpace(empresa.NomeFantasia)) { <div><span>Nome fantasia</span><strong>@empresa.NomeFantasia</strong></div> }
            @if (!string.IsNullOrWhiteSpace(empresa.Cnpj)) { <div><span>CNPJ</span><strong>@Web.Models.CnpjFormatador.Formatar(empresa.Cnpj)</strong></div> }
            @if (!string.IsNullOrWhiteSpace(empresa.Telefone)) { <div><span>Telefone</span><strong>@empresa.Telefone</strong></div> }
            @if (!string.IsNullOrWhiteSpace(empresa.WhatsApp)) { <div><span>WhatsApp</span><strong>@empresa.WhatsApp</strong></div> }
            @if (!string.IsNullOrWhiteSpace(endereco)) { <div class="credenciamento-detalhe-completo"><span>Endereço</span><strong>@endereco</strong></div> }
        </div>
        @if (especialidades.Count > 0 || procedimentos.Count > 0)
        {
            <div class="credenciamento-servicos">
                @if (especialidades.Count > 0) { <div><span>Especialidades</span><strong>@string.Join(", ", especialidades)</strong></div> }
                @if (procedimentos.Count > 0) { <div><span>Procedimentos</span><strong>@string.Join(", ", procedimentos)</strong></div> }
            </div>
        }
    </div>
</article>
