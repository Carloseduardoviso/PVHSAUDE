@model Web.Models.ContatoVm
@{ ViewData["Title"] = "Contato"; }
<h1 class="h2 mb-4">Entre em contato conosco</h1>
@if (TempData["Sucesso"] is string s) { <div class="alert alert-success">@s</div> }
<form asp-action="Index" method="post" class="card card-body" style="max-width:800px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Sobrenome" class="form-label"></label><input asp-for="Sobrenome" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Cpf" class="form-label"></label><input asp-for="Cpf" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Motivo" class="form-label"></label><select asp-for="Motivo" class="form-select"><option value="">Selecione...</option><option>Dúvida</option><option>Solicitação</option><option>Reclamação</option><option>Elogio</option><option>Outro</option></select></div>
        <div class="col-12"><label asp-for="Mensagem" class="form-label"></label><textarea asp-for="Mensagem" class="form-control" rows="6"></textarea></div>
    </div>
    <button class="btn btn-success mt-4" type="submit">Enviar mensagem</button>
</form>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
