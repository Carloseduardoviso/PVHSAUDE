@model IReadOnlyCollection<CredenciadoVm>
@{ ViewData["Title"] = "Empresas Beneficiadas"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h3">Empresas Beneficiadas</h1><p class="text-muted mb-0">Gerencie as empresas beneficiadas.</p></div>
    <a asp-action="Create" class="btn btn-success">Cadastrar empresa beneficiada</a>
</div>
<form method="get" class="card card-body shadow-sm mb-4"><div class="row g-3 align-items-end"><div class="col-md-6"><label for="nomeFantasia" class="form-label">Nome fantasia</label><input id="nomeFantasia" name="nomeFantasia" value="@ViewBag.NomeFantasia" class="form-control" /></div><div class="col-md-4"><label for="dataCadastro" class="form-label">Data de cadastro</label><input id="dataCadastro" name="dataCadastro" type="date" value="@ViewBag.DataCadastro" class="form-control" /></div><div class="col-md-2 d-flex gap-2"><button type="submit" class="btn btn-primary">Buscar</button><a asp-action="Index" class="btn btn-light">Limpar</a></div></div></form>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if ((TempData["Error"] ?? ViewData["Error"]) is string error) { <div class="alert alert-danger">@error</div> }
@if (!Model.Any() && ViewData["Error"] is null) { <div class="alert alert-info" role="status">Nenhuma empresa beneficiada cadastrada.</div> }
else if (Model.Any()) {
<div class="card shadow-sm table-responsive d-none d-md-block" role="region" aria-label="Tabela de registros; role horizontalmente para ver todas as colunas" tabindex="0"><table class="table table-hover mb-0">
    <thead><tr><th>Imagem</th><th>Nome fantasia</th><th>Tipo</th><th>Telefone</th><th>Data de cadastro</th><th>Situação</th><th>Ações</th></tr></thead>
    <tbody>@foreach (var empresa in Model) {
        <tr><td>@if (!string.IsNullOrWhiteSpace(empresa.ImagemUrl)) { <img src="@empresa.ImagemUrl" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px" /> }</td><td>@empresa.NomeFantasia</td><td>@Html.DisplayFor(_ => empresa.Tipo)</td><td>@empresa.Telefone</td><td>@empresa.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@Html.DisplayFor(_ => empresa.StatusCredenciamento)</td>
        <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@empresa.Id" class="btn btn-sm btn-outline-primary">Editar</a> <form asp-action="Excluir" asp-route-id="@empresa.Id" method="post" class="d-inline" data-swal-confirm data-swal-title="Excluir empresa beneficiada?" data-swal-text="Deseja excluir @empresa.NomeFantasia? Esta ação não pode ser desfeita." data-swal-confirm-text="Sim, excluir"><button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button></form> <a asp-action="Details" asp-route-id="@empresa.Id" class="btn btn-sm btn-outline-secondary">Ver detalhes</a></td></tr>
    }</tbody>
</table></div>
<div class="admin-record-cards d-md-none">
@foreach (var empresa in Model) {
    <article class="card shadow-sm"><div class="card-body"><dl class="mb-0">
        <dt>Imagem</dt><dd>@if (!string.IsNullOrWhiteSpace(empresa.ImagemUrl)) { <img src="@empresa.ImagemUrl" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px" /> }</dd>
        <dt>Nome fantasia</dt><dd>@empresa.NomeFantasia</dd>
        <dt>Tipo</dt><dd>@Html.DisplayFor(_ => empresa.Tipo)</dd>
        <dt>Telefone</dt><dd>@empresa.Telefone</dd>
        <dt>Data de cadastro</dt><dd>@empresa.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy")</dd>
        <dt>Situação</dt><dd>@Html.DisplayFor(_ => empresa.StatusCredenciamento)</dd>
        </dl><div class="admin-record-actions border-top pt-3 mt-3" aria-label="Ações do registro">
<a asp-action="Edit" asp-route-id="@empresa.Id" class="btn btn-sm btn-outline-primary">Editar</a> <form asp-action="Excluir" asp-route-id="@empresa.Id" method="post" data-swal-confirm data-swal-title="Excluir empresa beneficiada?" data-swal-text="Deseja excluir @empresa.NomeFantasia? Esta ação não pode ser desfeita." data-swal-confirm-text="Sim, excluir"><button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button></form> <a asp-action="Details" asp-route-id="@empresa.Id" class="btn btn-sm btn-outline-secondary">Ver detalhes</a>
        </div></div></article>
}
</div>

}
