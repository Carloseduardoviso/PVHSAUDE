@model CredenciadoVm
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<div class="row g-3">
    <div class="col-12"><label asp-for="PlanoId" class="form-label"></label><input class="form-control" style="background-color:#d9dde3;border-color:#adb5bd;color:#495057;" value="@(((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>?)ViewBag.Planos)?.FirstOrDefault(x => x.Value == Model.PlanoId?.ToString())?.Text ?? "Não vinculado")" readonly /><input asp-for="PlanoId" type="hidden" /><span asp-validation-for="PlanoId" class="text-danger"></span><div class="form-text">Plano vinculado à empresa beneficiada.</div></div>
    <div class="col-md-6"><label asp-for="RazaoSocial" class="form-label"></label><input asp-for="RazaoSocial" class="form-control" maxlength="150" /><span asp-validation-for="RazaoSocial" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="NomeFantasia" class="form-label"></label><input asp-for="NomeFantasia" class="form-control" maxlength="150" /><span asp-validation-for="NomeFantasia" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Cnpj" class="form-label"></label><input asp-for="Cnpj" class="form-control" maxlength="18" data-cred-mask="cnpj" inputmode="numeric" /><span asp-validation-for="Cnpj" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" maxlength="20" data-cred-mask="telefone" inputmode="numeric" /><span asp-validation-for="Telefone" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="WhatsApp" class="form-label"></label><input asp-for="WhatsApp" class="form-control" maxlength="20" data-cred-mask="telefone" inputmode="numeric" /><span asp-validation-for="WhatsApp" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" maxlength="254" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Cep" class="form-label"></label><input asp-for="Cep" class="form-control" maxlength="9" data-cred-mask="cep" inputmode="numeric" aria-describedby="cep-status" /><span asp-validation-for="Cep" class="text-danger"></span><div id="cep-status" class="form-text" role="status" aria-live="polite"></div></div>
    <div class="col-md-3"><label for="Numero" class="form-label">Número</label><input id="Numero" name="Numero" class="form-control" maxlength="20" autocomplete="address-line2" /></div>
    <div class="col-md-9"><label asp-for="Endereco" class="form-label"></label><input asp-for="Endereco" class="form-control" maxlength="250" autocomplete="street-address" /></div>
    <div class="col-12"><label asp-for="Observacoes" class="form-label"></label><textarea asp-for="Observacoes" class="form-control" rows="3"></textarea><span asp-validation-for="Observacoes" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="StatusCredenciamento" class="form-label"></label><select asp-for="StatusCredenciamento" asp-items="Html.GetEnumSelectList<PVHSAUDE.Domain.Enuns.StatusCredenciamento>()" class="form-select"></select><span asp-validation-for="StatusCredenciamento" class="text-danger"></span></div>
</div>
