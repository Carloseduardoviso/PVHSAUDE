@model List<Web.Models.ContatoVm>
@{ViewData["Title"]="Mensagens de contato";}
<h1 class="h3 mb-4">Mensagens de contato</h1>
@if(TempData["Sucesso"] is string s){<div class="alert alert-success">@s</div>} @if(TempData["Erro"] is string e){<div class="alert alert-danger">@e</div>}
@if(ViewData["Erro"] is string er){<div class="alert alert-warning">@er</div>}else if(Model.Count==0){<p class="text-muted">Nenhuma mensagem recebida.</p>}else{<div class="table-responsive d-none d-md-block" role="region" aria-label="Tabela de registros; role horizontalmente para ver todas as colunas" tabindex="0"><table class="table table-striped align-middle"><thead><tr><th>Data</th><th>Nome</th><th>E-mail</th><th>Motivo</th><th>Ações</th></tr></thead><tbody>@foreach(var m in Model){<tr><td>@m.EnviadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@m.Nome @m.Sobrenome</td><td>@m.Email</td><td>@m.Motivo</td><td><a asp-action="Detalhes" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Detalhes</a> <form asp-action="Excluir" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm('Excluir esta mensagem?');"><button class="btn btn-sm btn-outline-danger">Excluir</button></form></td></tr>}</tbody></table></div>
<div class="admin-record-cards d-md-none">
@foreach(var m in Model){
    <article class="card shadow-sm"><div class="card-body"><dl class="mb-0">
        <dt>Data</dt><dd>@m.EnviadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        <dt>Nome</dt><dd>@m.Nome @m.Sobrenome</dd>
        <dt>E-mail</dt><dd>@m.Email</dd>
        <dt>Motivo</dt><dd>@m.Motivo</dd>
        </dl><div class="admin-record-actions border-top pt-3 mt-3" aria-label="Ações do registro">
<a asp-action="Detalhes" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Detalhes</a> <form asp-action="Excluir" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm('Excluir esta mensagem?');"><button class="btn btn-sm btn-outline-danger">Excluir</button></form>
        </div></div></article>
}
</div>
}
