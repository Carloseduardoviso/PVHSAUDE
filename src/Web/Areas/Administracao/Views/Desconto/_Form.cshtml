@model PlanoVm
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /></div><div class="col-md-6"><label asp-for="TipoPessoa" class="form-label"></label><select asp-for="TipoPessoa" asp-items="Html.GetEnumSelectList<PVHSAUDE.Domain.Enuns.TipoPessoa>()" class="form-select"></select></div><div class="col-12"><label asp-for="Descricao" class="form-label"></label><textarea asp-for="Descricao" class="form-control"></textarea></div><div class="col-md-4"><label asp-for="Valor" class="form-label"></label><input asp-for="Valor" type="text" value="@Model.Valor.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))" inputmode="numeric" class="form-control" data-mask="moeda" data-rule-number="false" data-rule-range="false" data-rule-moeda="true" /><span asp-validation-for="Valor" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Periodicidade" class="form-label"></label><select asp-for="Periodicidade" asp-items="Html.GetEnumSelectList<PVHSAUDE.Domain.Enuns.Periodicidade>()" class="form-select"></select></div><div class="col-md-4"><label asp-for="DataValidade" class="form-label"></label><input asp-for="DataValidade" class="form-control" /></div></div>
