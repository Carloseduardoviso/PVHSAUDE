@model IReadOnlyCollection<PlanoVm>
@{ ViewData["Title"] = "Descontos"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3">Descontos</h1><a asp-action="Create" class="btn btn-success">Cadastrar desconto</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (Model.Count == 0) { <div class="alert alert-info" role="status">Nenhum desconto cadastrado.</div> }
else { <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Nome</th><th>Valor</th><th>Periodicidade</th><th>Tipo de pessoa</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td><td>@item.Periodicidade</td><td>@item.TipoPessoa</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td></tr> }
</tbody></table></div> }
