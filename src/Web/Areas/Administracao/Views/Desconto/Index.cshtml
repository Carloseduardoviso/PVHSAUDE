@model IReadOnlyCollection<CatalogoItemVm>
@{ ViewData["Title"] = "Descontos"; }
<h1 class="h3 mb-4">Descontos</h1>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="post" class="card card-body mb-4"><div class="input-group"><input name="nome" class="form-control" placeholder="Novo desconto" maxlength="150" required /><button class="btn btn-success">Cadastrar</button></div></form>
@if (Model.Count == 0) { <div class="alert alert-info" role="status">Nenhum desconto cadastrado.</div> }
<ul class="list-group">@foreach (var item in Model) { <li class="list-group-item d-flex flex-nowrap align-items-center gap-2 catalogo-item"><form asp-action="Editar" method="post" class="d-flex flex-nowrap flex-grow-1 align-items-center gap-2 catalogo-editar"><input type="hidden" name="id" value="@item.Id" /><input name="nome" value="@item.Nome" class="form-control" maxlength="150" required /><button class="btn btn-sm btn-outline-primary">Editar</button></form><form asp-action="Excluir" method="post" class="catalogo-excluir" data-swal-confirm data-swal-title="Excluir desconto?" data-swal-text="Ele ficará inativo e os vínculos serão preservados." data-swal-confirm-text="Sim, excluir"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Excluir</button></form></li> }</ul>
