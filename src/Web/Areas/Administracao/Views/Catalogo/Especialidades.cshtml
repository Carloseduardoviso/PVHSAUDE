@model IReadOnlyCollection<CatalogoItemVm>
@{ ViewData["Title"] = "Especialidades"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3 mb-0">Especialidades</h1><a asp-action="Procedimentos" class="btn btn-outline-secondary">Procedimentos</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="post" class="card card-body mb-4"><div class="input-group"><input name="nome" class="form-control" placeholder="Nova especialidade" required /><button class="btn btn-success">Cadastrar</button></div></form>
<ul class="list-group">@foreach(var item in Model){<li class="list-group-item d-flex flex-nowrap align-items-center gap-2 catalogo-item"><form asp-action="EditarEspecialidade" method="post" class="d-flex flex-nowrap flex-grow-1 align-items-center gap-2 catalogo-editar"><input type="hidden" name="id" value="@item.Id" /><input name="nome" value="@item.Nome" class="form-control" maxlength="150" required /><button class="btn btn-sm btn-outline-primary">Editar</button></form><form asp-action="ExcluirEspecialidade" method="post" class="catalogo-excluir" onsubmit="return confirm('Excluir esta especialidade? Ela ficará inativa e os vínculos serão preservados.');"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Excluir</button></form></li>}</ul>
