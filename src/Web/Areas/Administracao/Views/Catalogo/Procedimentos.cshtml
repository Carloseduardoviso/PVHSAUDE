@model IReadOnlyCollection<CatalogoItemVm>
@{ ViewData["Title"] = "Procedimentos"; }
<div class="d-flex justify-content-between mb-4"><h1 class="h3">Procedimentos</h1><a asp-action="Especialidades" class="btn btn-outline-secondary">Especialidades</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="post" class="card card-body mb-4"><div class="input-group"><input name="nome" class="form-control" placeholder="Novo procedimento" required maxlength="150" /><button class="btn btn-success">Cadastrar</button></div></form>
<div class="card"><ul class="list-group list-group-flush">@foreach(var item in Model){<li class="list-group-item d-flex flex-nowrap align-items-center gap-2 catalogo-item"><form asp-action="EditarProcedimento" method="post" class="d-flex flex-nowrap flex-grow-1 align-items-center gap-2 catalogo-editar"><input type="hidden" name="id" value="@item.Id" /><input name="nome" value="@item.Nome" class="form-control" maxlength="150" required /><button class="btn btn-sm btn-outline-primary">Editar</button></form><form asp-action="ExcluirProcedimento" method="post" class="catalogo-excluir" data-swal-confirm data-swal-title="Excluir procedimento?" data-swal-text="Ele ficará inativo e os vínculos serão preservados." data-swal-confirm-text="Sim, excluir"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Excluir</button></form></li>}</ul></div>
