@model IReadOnlyCollection<PlanoViewModel>
@{ ViewData["Title"] = "Planos"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h3">Planos</h1><p class="text-muted mb-0">Gerencie os planos disponíveis para os beneficiários.</p></div>
    <a asp-action="Create" class="btn btn-success">Cadastrar plano</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (ViewData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
else if (!Model.Any()) { <div class="alert alert-info">Nenhum plano cadastrado. Cadastre o primeiro plano para vinculá-lo aos beneficiários.</div> }
else {
<div class="card shadow-sm table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Nome</th><th>Valor</th><th>Periodicidade</th><th>Validade</th><th>Ações</th></tr></thead>
    <tbody>@foreach (var plano in Model) {
        <tr><td>@plano.Nome</td><td>@plano.Valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td><td>@plano.Periodicidade</td><td>@(plano.DataValidade?.ToString("dd/MM/yyyy") ?? "Sem validade definida")</td><td><a asp-action="Edit" asp-route-id="@plano.Id" class="btn btn-sm btn-outline-primary">Editar</a></td></tr>
    }</tbody>
</table></div>
}
