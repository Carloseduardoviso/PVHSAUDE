@model DependenteViewModel
<div class="dependente-item border rounded p-3 mb-3">
    <input type="hidden" name="Dependentes.Index" value="@ViewData["Indice"]" />
    <input asp-for="Id" type="hidden" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 mb-0">Dependente</h2>
        <button type="button" class="btn btn-sm btn-outline-danger remover-dependente">Remover</button>
    </div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label" for="plano-dependente-@ViewData["Indice"]">Plano do beneficiário</label><input id="plano-dependente-@ViewData["Indice"]" class="form-control codigo-readonly" data-dependente-plano readonly aria-readonly="true" /></div>
        <div class="col-md-6"><label class="form-label" for="valor-dependente-@ViewData["Indice"]">Valor do dependente</label><input id="valor-dependente-@ViewData["Indice"]" class="form-control codigo-readonly" value="R$ 11,90" readonly aria-readonly="true" /></div>
        <div class="col-md-4"><label asp-for="Codigo" class="form-label"></label><input asp-for="Codigo" class="form-control codigo-readonly" data-codigo-dependente readonly aria-readonly="true" /></div>
        <div class="col-md-6"><label asp-for="Nome" class="form-label">Nome completo</label><input asp-for="Nome" class="form-control" required /><span asp-validation-for="Nome" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Cpf" class="form-label">CPF</label><input asp-for="Cpf" class="form-control" data-mask="cpf" inputmode="numeric" maxlength="14" required /><span asp-validation-for="Cpf" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="DataNascimento" class="form-label">Data de nascimento</label><input asp-for="DataNascimento" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" min="1900-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" data-rule-min="false" data-rule-max="false" data-rule-birthdate="true" required /><span asp-validation-for="DataNascimento" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="GrauParentesco" class="form-label">Parentesco</label><select asp-for="GrauParentesco" asp-items="Html.GetEnumSelectList<PVHSAUDE.Domain.Enuns.GrauParentesco>()" class="form-select" required><option value="">Selecione o parentesco</option></select><span asp-validation-for="GrauParentesco" class="text-danger"></span></div>
    </div>
</div>

