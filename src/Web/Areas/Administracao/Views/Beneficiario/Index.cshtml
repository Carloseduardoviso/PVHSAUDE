@model IReadOnlyCollection<BeneficiarioVm>
@{
    ViewData["Title"] = "Beneficiários";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">Beneficiários</h1><p class="text-muted mb-0">Cadastros que alimentam o portal PVH Saúde.</p></div>
    <a asp-action="Create" class="btn btn-success">Cadastrar beneficiário</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (Model.Any())
{
<div class="card shadow-sm admin-list-panel"><div class="table-responsive d-none d-md-block" role="region" aria-label="Tabela de registros; role horizontalmente para ver todas as colunas" tabindex="0"><table class="table table-hover mb-0">
<thead><tr><th>Nome</th><th>CPF</th><th>Telefone</th><th>Situação</th><th>Dependentes</th><th class="text-end">Ações</th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr><td>@item.Nome</td><td>@item.Cpf</td><td>@item.Telefone</td><td>@((PVHSAUDE.Domain.Enuns.StatusBeneficiario)item.Status)</td><td>@item.Dependentes.Count</td><td class="text-end">
<a asp-action="Edit" asp-route-id="@item.BeneficiarioId" class="btn btn-sm btn-outline-primary">Editar</a>
<a asp-action="Details" asp-route-id="@item.BeneficiarioId" class="btn btn-sm btn-outline-secondary">Ver detalhes</a>
@if (item.Status != (int)PVHSAUDE.Domain.Enuns.StatusBeneficiario.Inativo)
{
<form asp-action="Inativar" asp-route-id="@item.BeneficiarioId" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Inativar este beneficiário? O cadastro e os dependentes serão mantidos.')">Inativar</button></form>
}
</td></tr> }
</tbody></table></div>
<div class="admin-record-cards d-md-none">
@foreach (var item in Model) {
    <article class="card shadow-sm"><div class="card-body"><dl class="mb-0">
        <dt>Nome</dt><dd>@item.Nome</dd>
        <dt>CPF</dt><dd>@item.Cpf</dd>
        <dt>Telefone</dt><dd>@item.Telefone</dd>
        <dt>Situação</dt><dd>@((PVHSAUDE.Domain.Enuns.StatusBeneficiario)item.Status)</dd>
        <dt>Dependentes</dt><dd>@item.Dependentes.Count</dd>
        </dl><div class="admin-record-actions border-top pt-3 mt-3" aria-label="Ações do registro">

<a asp-action="Edit" asp-route-id="@item.BeneficiarioId" class="btn btn-sm btn-outline-primary">Editar</a>
<a asp-action="Details" asp-route-id="@item.BeneficiarioId" class="btn btn-sm btn-outline-secondary">Ver detalhes</a>
@if (item.Status != (int)PVHSAUDE.Domain.Enuns.StatusBeneficiario.Inativo)
{
<form asp-action="Inativar" asp-route-id="@item.BeneficiarioId" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Inativar este beneficiário? O cadastro e os dependentes serão mantidos.')">Inativar</button></form>
}

        </div></div></article>
}
</div>
</div>
}
else
{
    <div class="alert alert-info" role="status">Nenhum beneficiário cadastrado.</div>
}
