@{ var controller = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Administração PVH Saúde</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/administracao.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-area="Administracao" asp-controller="Dashboard" asp-action="Index" aria-label="PVH Saúde — início da administração"><img src="~/images/pvh-saude-circular.jpeg" asp-append-version="true" alt="PVH Saúde" width="1024" height="1024" /></a>
            <p class="admin-caption">Área administrativa</p>
            <button class="btn btn-outline-light d-lg-none mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#admin-menu" aria-controls="admin-menu" aria-expanded="false">Menu</button>
            <nav id="admin-menu" class="collapse d-lg-block" aria-label="Menu administrativo">
                <a class="admin-nav-link @(controller == "Dashboard" ? "active" : "")" aria-current="@(controller == "Dashboard" ? "page" : null)" asp-area="Administracao" asp-controller="Dashboard" asp-action="Index"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>Home</a>
                @foreach (var menu in PVHSAUDE.Domain.Enuns.MenusAdministrativos.Opcoes)
                {
                    if (!PVHSAUDE.Application.ViewModels.AcessoMenu.PodeAcessar(User, menu.Key)) { continue; }
                    var catalogo = menu.Key is "Especialidades" or "Procedimentos";
                    var destino = catalogo ? "Catalogo" : menu.Key;
                    var acao = catalogo ? menu.Key : "Index";
                    var selecionado = controller == destino && (!catalogo || ViewContext.RouteData.Values["action"]?.ToString() == acao);
                    <a class="admin-nav-link @(selecionado ? "active" : "")" aria-current="@(selecionado ? "page" : null)" asp-area="Administracao" asp-controller="@destino" asp-action="@acao"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>@menu.Value</a>
                }
                @if (User.IsInRole("Administrador"))
                {
                    <a class="admin-nav-link @(controller == "Usuario" ? "active" : "")" asp-area="Administracao" asp-controller="Usuario" asp-action="Index"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="3" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0m1.5-8a3 3 0 0 1 0 6m-1.5 2h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Usuários</a>
                }
                <a class="admin-nav-link mt-4" asp-area="" asp-controller="Home" asp-action="Index"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>Voltar ao portal</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="text-white mt-3">@User.Identity.Name</p>
                    <form asp-area="" asp-controller="Conta" asp-action="Sair" method="post"><button class="btn btn-outline-light" type="submit"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h5m4-5 3-3-3-3m3 3H9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>Sair</button></form>
                }
            </nav>
        </aside>
        <div class="admin-content">
            <header class="admin-header d-flex align-items-center justify-content-between gap-3"><span>Administração <span class="text-muted">/ @ViewData["Title"]</span></span>@await Component.InvokeAsync("PlanoAvisos")</header>
            <main id="conteudo" class="p-3 p-lg-4">@RenderBody()</main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
