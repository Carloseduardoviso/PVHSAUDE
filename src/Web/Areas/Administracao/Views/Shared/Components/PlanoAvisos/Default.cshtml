@model IReadOnlyCollection<Web.Models.PlanoVm>
<button type="button" class="admin-notification-bell @(Model.Any() ? "has-notifications" : string.Empty)" data-bs-toggle="modal" data-bs-target="#planoAvisosModal" aria-label="Notificações de validade">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 17h-1v-6a5 5 0 0 0-4-4.9V5a1 1 0 0 0-2 0v1.1A5 5 0 0 0 7 11v6H6a1 1 0 0 0 0 2h4a2 2 0 0 0 4 0h4a1 1 0 0 0 0-2Zm-6 2a.5.5 0 0 1-.5-.5h1a.5.5 0 0 1 1 .5.5 0 0 1-.5.5Z" /></svg>
    @if (Model.Any()) { <span class="admin-notification-count">@Model.Count</span> }
</button>
<div class="modal fade" id="planoAvisosModal" tabindex="-1" aria-labelledby="planoAvisosTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="planoAvisosTitulo">Notificações de planos</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body">
@if (!Model.Any()) { <p class="text-muted mb-0">Não há notificações de validade.</p> }
@foreach (var plano in Model) { var dias = (plano.DataValidade!.Value.Date - DateTime.Today).Days; var mensagem = dias switch { 1 => $"O plano {plano.Nome} vence em 1 dia ({plano.DataValidade.Value:dd/MM/yyyy}).", 0 => $"O plano {plano.Nome} vence hoje.", _ => $"O plano {plano.Nome} venceu há {-dias} dia{(-dias == 1 ? string.Empty : "s")} ({plano.DataValidade.Value:dd/MM/yyyy})." }; <div class="alert @(dias < 0 ? "alert-danger" : "alert-warning") d-flex flex-column align-items-start gap-3"><span>@mensagem</span><form asp-area="Administracao" asp-controller="Plano" asp-action="SuspenderNotificacaoValidade" method="post"><input type="hidden" name="id" value="@plano.Id" /><button class="btn btn-sm btn-outline-secondary" type="submit">Suspender</button></form></div> }
</div></div></div></div>
