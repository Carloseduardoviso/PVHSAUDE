@model IReadOnlyCollection<Web.Models.IntencaoVendaVm>
<button type="button" class="admin-notification-bell @(Model.Any() ? "has-notifications" : string.Empty)" data-bs-toggle="modal" data-bs-target="#intencaoAvisosModal" aria-label="Notificações de intenções de venda">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h2l2.2 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 8H6M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm8 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    @if (Model.Any()) { <span class="admin-notification-count">@Model.Count</span> }
</button>
<div class="modal fade" id="intencaoAvisosModal" tabindex="-1" aria-labelledby="intencaoAvisosTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="intencaoAvisosTitulo">Intenções de venda</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body">
@if (!Model.Any()) { <p class="text-muted mb-0">Não há intenções de venda.</p> }
@foreach (var intencao in Model) { <div class="alert alert-info d-flex flex-column align-items-start gap-2"><strong>@intencao.Nome</strong><span>@intencao.PlanoNome — @intencao.ValorTotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</span><small class="text-muted">@intencao.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-area="Administracao" asp-controller="IntencaoVenda" asp-action="Detalhes" asp-route-id="@intencao.Id">Ver intenção</a><form asp-area="Administracao" asp-controller="IntencaoVenda" asp-action="SuspenderNotificacao" method="post"><input type="hidden" name="id" value="@intencao.Id" /><button class="btn btn-sm btn-outline-secondary" type="submit">Suspender</button></form></div></div> }
</div></div></div></div>
