@model IReadOnlyCollection<Web.Models.ContatoVm>
<button type="button" class="admin-notification-bell @(Model.Any() ? "has-notifications" : string.Empty)" data-bs-toggle="modal" data-bs-target="#contatoAvisosModal" aria-label="Notificações de mensagens">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.8 9 3l2 4.5-1.8 1.5a13.4 13.4 0 0 0 5.8 5.8l1.5-1.8 4.5 2-.8 2.4a2 2 0 0 1-2.2 1.3C10.8 17.7 6.3 13.2 5.3 6a2 2 0 0 1 1.3-2.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    @if (Model.Any()) { <span class="admin-notification-count">@Model.Count</span> }
</button>
<div class="modal fade" id="contatoAvisosModal" tabindex="-1" aria-labelledby="contatoAvisosTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="contatoAvisosTitulo">Mensagens recebidas</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body">
@if (!Model.Any()) { <p class="text-muted mb-0">Não há mensagens recebidas.</p> }
@foreach (var mensagem in Model) { <div class="alert alert-info d-flex flex-column align-items-start gap-2"><strong>@mensagem.Nome @mensagem.Sobrenome</strong><span>@mensagem.Mensagem</span><small class="text-muted">@mensagem.EnviadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-area="Administracao" asp-controller="Contato" asp-action="Detalhes" asp-route-id="@mensagem.Id">Ver mensagem</a><form asp-area="Administracao" asp-controller="Contato" asp-action="SuspenderNotificacao" method="post"><input type="hidden" name="id" value="@mensagem.Id" /><button class="btn btn-sm btn-outline-secondary" type="submit">Suspender</button></form></div></div> }
</div></div></div></div>
