@model CredenciadoVm
@{ ViewData["Title"] = "Editar credenciamento"; }
<h1 class="h3 mb-4">Editar credenciamento</h1>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card card-body shadow-sm">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <div class="mt-4"><a asp-action="Index" class="btn btn-light">Cancelar</a> <button type="submit" class="btn btn-success">Salvar empresa</button></div>
</form>
@{
    var imagensSalvas = Model.ImagemUrls?.Any() == true ? Model.ImagemUrls : (!string.IsNullOrWhiteSpace(Model.ImagemUrl) ? new List<string> { Model.ImagemUrl } : new List<string>());
}
@for (var indice = 0; indice < imagensSalvas.Count; indice++)
{
    <form id="remover-imagem-@indice" asp-action="RemoverImagem" method="post" data-swal-confirm data-swal-title="Remover imagem?" data-swal-text="A imagem será removida deste credenciamento." data-swal-confirm-text="Sim, remover">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="url" value="@imagensSalvas[indice]" />
    </form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> <script src="~/js/credenciado-form.js" asp-append-version="true"></script> }
