@model CredenciadoViewModel
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<div class="mb-3 text-center"><div id="imagem-preview-container" class="mb-3" @(!string.IsNullOrWhiteSpace(Model.ImagemUrl) ? "" : "hidden")><img id="imagem-preview" src="@Model.ImagemUrl" alt="Imagem da empresa" style="width:140px;height:140px;object-fit:cover;border-radius:50%;border:3px solid #198754;padding:3px" /></div><label asp-for="Imagem" class="form-label"></label><input asp-for="Imagem" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" /><div class="form-text">JPG, PNG ou WEBP, até 5 MB.</div><span asp-validation-for="Imagem" class="text-danger"></span></div>
<div class="row g-3">
    <div class="col-12"><label asp-for="PlanoId" class="form-label"></label><select asp-for="PlanoId" asp-items="ViewBag.Planos" class="form-select" required><option value="">Selecione o plano da empresa</option></select><span asp-validation-for="PlanoId" class="text-danger"></span><div class="form-text">Este plano será preenchido ao selecionar a empresa no beneficiário.</div></div>
    <div class="col-md-6"><label asp-for="RazaoSocial" class="form-label"></label><input asp-for="RazaoSocial" class="form-control" maxlength="150" /><span asp-validation-for="RazaoSocial" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="NomeFantasia" class="form-label"></label><input asp-for="NomeFantasia" class="form-control" maxlength="150" /><span asp-validation-for="NomeFantasia" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Cnpj" class="form-label"></label><input asp-for="Cnpj" class="form-control" maxlength="18" data-cred-mask="cnpj" inputmode="numeric" /><span asp-validation-for="Cnpj" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" maxlength="20" data-cred-mask="telefone" inputmode="numeric" /><span asp-validation-for="Telefone" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="WhatsApp" class="form-label"></label><input asp-for="WhatsApp" class="form-control" maxlength="20" data-cred-mask="telefone" inputmode="numeric" /><span asp-validation-for="WhatsApp" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" maxlength="254" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Cep" class="form-label"></label><input asp-for="Cep" class="form-control" maxlength="9" data-cred-mask="cep" inputmode="numeric" aria-describedby="cep-status" /><span asp-validation-for="Cep" class="text-danger"></span><div id="cep-status" class="form-text" role="status" aria-live="polite"></div></div>
    <input asp-for="Endereco" type="hidden" />
    <div class="col-md-6"><label asp-for="Cidade" class="form-label"></label><input asp-for="Cidade" class="form-control" maxlength="100" /><span asp-validation-for="Cidade" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Uf" class="form-label"></label><input asp-for="Uf" class="form-control" maxlength="2" /><span asp-validation-for="Uf" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Observacoes" class="form-label"></label><textarea asp-for="Observacoes" class="form-control" rows="3"></textarea><span asp-validation-for="Observacoes" class="text-danger"></span></div>
    <div class="col-12"><label class="form-label">Especialidades</label><div class="catalogo-opcoes">@foreach (var item in (IEnumerable<CatalogoItemViewModel>)ViewBag.Especialidades) { <label class="catalogo-opcao"><input type="checkbox" name="EspecialidadeIds" value="@item.Id" checked="@Model.EspecialidadeIds.Contains(item.Id)" /> <span>@item.Nome</span></label> }</div></div>
    <div class="col-12"><label class="form-label">Procedimentos</label><div class="catalogo-opcoes">@foreach (var item in (IEnumerable<CatalogoItemViewModel>)ViewBag.Procedimentos) { <label class="catalogo-opcao"><input type="checkbox" name="ProcedimentoIds" value="@item.Id" checked="@Model.ProcedimentoIds.Contains(item.Id)" /> <span>@item.Nome</span></label> }</div></div>
    <div class="col-md-6"><label asp-for="Tipo" class="form-label"></label><select asp-for="Tipo" asp-items="Html.GetEnumSelectList<PVHSAUDE.Domain.Enuns.TipoCredenciado>()" class="form-select"><option value="">Selecione o tipo</option></select><span asp-validation-for="Tipo" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="StatusCredenciamento" class="form-label"></label><select asp-for="StatusCredenciamento" asp-items="Html.GetEnumSelectList<PVHSAUDE.Domain.Enuns.StatusCredenciamento>()" class="form-select"></select><span asp-validation-for="StatusCredenciamento" class="text-danger"></span></div>
</div>
