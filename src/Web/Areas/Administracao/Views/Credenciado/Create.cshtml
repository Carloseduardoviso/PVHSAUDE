@model CredenciadoVm
@{ ViewData["Title"] = "Cadastrar empresa credenciada"; }
<h1 class="h3 mb-4">Cadastrar empresa credenciada</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body shadow-sm">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <div class="mt-4"><a asp-action="Index" class="btn btn-light">Cancelar</a> <button type="submit" class="btn btn-success">Salvar empresa</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> <script src="~/js/credenciado-form.js" asp-append-version="true"></script> }
