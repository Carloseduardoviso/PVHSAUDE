@model IReadOnlyCollection<CredenciadoViewModel>
@{ ViewData["Title"] = "Empresas credenciadas"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h3">Empresas credenciadas</h1><p class="text-muted mb-0">Gerencie os estabelecimentos da rede credenciada.</p></div>
    <a asp-action="Create" class="btn btn-success">Cadastrar empresa</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (ViewData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
else if (!Model.Any()) { <div class="alert alert-info">Nenhuma empresa credenciada cadastrada.</div> }
else {
<div class="card shadow-sm table-responsive"><table class="table table-hover mb-0">
    <thead><tr><th>Imagem</th><th>Nome fantasia</th><th>CNPJ</th><th>Tipo</th><th>Telefone</th><th>Cidade</th><th>Situação</th><th>Ações</th></tr></thead>
    <tbody>@foreach (var empresa in Model) {
        <tr><td>@if (!string.IsNullOrWhiteSpace(empresa.ImagemUrl)) { <img src="@empresa.ImagemUrl" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px" /> }</td><td>@empresa.NomeFantasia</td><td>@empresa.Cnpj</td><td>@Html.DisplayFor(_ => empresa.Tipo)</td><td>@empresa.Telefone</td><td>@empresa.Cidade</td><td>@Html.DisplayFor(_ => empresa.StatusCredenciamento)</td>
        <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@empresa.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Details" asp-route-id="@empresa.Id" class="btn btn-sm btn-outline-secondary">Ver detalhes</a></td></tr>
    }</tbody>
</table></div>
}
