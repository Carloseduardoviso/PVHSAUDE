@model PVHSAUDE.Application.ViewModels.UsuarioVm
<div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.UsuarioId" class="btn btn-sm btn-outline-primary">Editar</a>
            <form asp-action="@(Model.Ativo ? "Inativar" : "Ativar")" asp-route-id="@Model.UsuarioId" method="post">
                <button class="btn btn-sm btn-outline-warning" type="submit">@(Model.Ativo ? "Inativar" : "Reativar")</button>
            </form>
            <form asp-action="Excluir" asp-route-id="@Model.UsuarioId" method="post" data-confirmar-exclusao data-usuario="@Model.NomeCompleto">
                <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
            </form>
        </div>