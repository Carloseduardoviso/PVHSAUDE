@model List<PVHSAUDE.Application.ViewModels.UsuarioVm>
@{ ViewData["Title"] = "Usuários"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3 mb-0">Usuários</h1><a asp-action="Create" class="btn btn-success">Cadastrar usuário</a></div>
@if (TempData["Success"] is string mensagem) { <div class="alert alert-success" role="status">@mensagem</div> }
@if (TempData["Error"] is string falha) { <div class="alert alert-danger" role="alert">@falha</div> }
@if (ViewData["Erro"] is string erro) { <div class="alert alert-warning" role="alert">@erro <a asp-action="Index">Tentar novamente</a></div> }
else if (Model.Count == 0) { <p class="text-muted">Nenhum usuário cadastrado.</p> }
else
{
    <div class="card table-responsive"><table class="table table-striped mb-0"><thead><tr><th scope="col">Nome completo</th><th scope="col">E-mail</th><th scope="col">Permissão</th><th scope="col">Status</th><th scope="col">Ações</th></tr></thead><tbody>
    @foreach (var usuario in Model)
    {
        <tr><td>@usuario.NomeCompleto</td><td>@usuario.Email</td><td>@usuario.Role</td><td><span class="badge @(usuario.Ativo ? "bg-success" : "bg-secondary")">@(usuario.Ativo ? "Ativo" : "Inativo")</span></td>
        <td><div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@usuario.UsuarioId" class="btn btn-sm btn-outline-primary">Editar</a>
            <form asp-action="@(usuario.Ativo ? "Inativar" : "Ativar")" asp-route-id="@usuario.UsuarioId" method="post">
                <button class="btn btn-sm btn-outline-warning" type="submit">@(usuario.Ativo ? "Inativar" : "Reativar")</button>
            </form>
            <form asp-action="Excluir" asp-route-id="@usuario.UsuarioId" method="post" data-confirmar-exclusao data-usuario="@usuario.NomeCompleto">
                <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
            </form>
        </div></td></tr>
    }
    </tbody></table></div>
}
@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}
