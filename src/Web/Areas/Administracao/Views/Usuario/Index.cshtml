@model List<PVHSAUDE.Application.ViewModels.UsuarioVm>
@{ ViewData["Title"] = "Usuários"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3 mb-0">Usuários</h1><a asp-action="Create" class="btn btn-success">Cadastrar usuário</a></div>
@if (TempData["Success"] is string mensagem) { <div class="alert alert-success" role="status">@mensagem</div> }
@if (TempData["Error"] is string falha) { <div class="alert alert-danger" role="alert">@falha</div> }
@if (ViewData["Erro"] is string erro) { <div class="alert alert-warning" role="alert">@erro <a asp-action="Index">Tentar novamente</a></div> }
else if (Model.Count == 0) { <div class="alert alert-info" role="status">Nenhum usuário cadastrado.</div> }
else
{
    <div class="card table-responsive d-none d-md-block" role="region" aria-label="Tabela de registros; role horizontalmente para ver todas as colunas" tabindex="0"><table class="table table-striped mb-0"><thead><tr><th scope="col">Nome completo</th><th scope="col">E-mail</th><th scope="col">Permissão</th><th scope="col">Status</th><th scope="col">Ações</th></tr></thead><tbody>
    @foreach (var usuario in Model)
    {
        <tr><td>@usuario.NomeCompleto</td><td>@usuario.Email</td><td>@usuario.Role</td><td><span class="badge @(usuario.Ativo ? "bg-success" : "bg-secondary")">@(usuario.Ativo ? "Ativo" : "Inativo")</span></td>
        <td><partial name="_Acoes" model="usuario" /></td></tr>
    }
    </tbody></table></div>
    <div class="usuario-cards d-md-none">
        @foreach (var usuario in Model)
        {
            <article class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">@usuario.NomeCompleto</h2>
                    <dl class="mb-3">
                        <dt>E-mail</dt>
                        <dd>@usuario.Email</dd>
                        <dt>Permissão</dt>
                        <dd>@usuario.Role</dd>
                        <dt>Status</dt>
                        <dd><span class="badge @(usuario.Ativo ? "bg-success" : "bg-secondary")">@(usuario.Ativo ? "Ativo" : "Inativo")</span></dd>
                    </dl>
                    <div class="usuario-card-acoes border-top pt-3">
                        <partial name="_Acoes" model="usuario" />
                    </div>
                </div>
            </article>
        }
    </div>
}
@section Scripts {
}
